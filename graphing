import matplotlib.pyplot as plt
import csv
import pandas as pd

data = []

with open('/Users/aandrade/Documents/GitHub/XRP autonomous bot/data', mode = 'r') as file:
    reader = csv.reader(file)
    for row in reader:
        data.append(row)

for row in data:
    points = [float(value) for value in row]
    plt.plot(points)

